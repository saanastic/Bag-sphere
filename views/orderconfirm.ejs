<%- include('./partials/header') %>

<div class="w-full min-h-screen flex items-center justify-center bg-zinc-100 px-4">

    <div class="bg-white rounded-2xl shadow-xl p-10 max-w-md w-full text-center">

        <!-- Checkmark -->
        <div class="w-20 h-20 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
        </div>

        <h1 class="text-3xl font-bold text-zinc-800 mb-2">Order Confirmed!</h1>
        <p class="text-zinc-500 mb-6">Thank you for shopping with BagSphere. Your order is being processed.</p>

        <div class="bg-zinc-50 rounded-xl p-5 text-left border border-zinc-200 mb-6">
            <div class="flex justify-between py-2 border-b border-zinc-200">
                <span class="text-zinc-500 text-sm">Order Amount</span>
                <span class="font-semibold">₹ <%= order.totalAmount %></span>
            </div>
            <div class="flex justify-between py-2 border-b border-zinc-200">
                <span class="text-zinc-500 text-sm">Status</span>
                <span class="text-green-600 font-semibold"><%= order.status %></span>
            </div>
            <div class="flex justify-between py-2">
                <span class="text-zinc-500 text-sm">Delivery To</span>
                <span class="font-semibold text-right max-w-[60%]"><%= order.address %></span>
            </div>
        </div>

        
            href="/shop"
            class="block w-full py-4 rounded-xl bg-black text-white text-lg font-semibold hover:bg-zinc-800 transition"
        >
            Continue Shopping
        </a>

    </div>

</div>

<%- include('./partials/footer') %>