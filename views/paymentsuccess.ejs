<%- include('./partials/header') %>

<div class="w-full min-h-screen bg-zinc-100 flex items-center justify-center px-4 py-10">

    <div class="w-full max-w-md bg-white border border-zinc-200 rounded-2xl shadow-md overflow-hidden mx-auto">

        <!-- SUCCESS HEADER -->

        <div class="bg-green-50 border-b border-zinc-200 px-6 sm:px-8 py-8 text-center">

            <div class="w-16 h-16 sm:w-18 sm:h-18 rounded-full bg-green-100 flex items-center justify-center mx-auto">

                <svg 
                    class="w-8 h-8 text-green-600" 
                    fill="none" 
                    stroke="currentColor" 
                    stroke-width="2.5" 
                    viewBox="0 0 24 24"
                >
                    <path 
                        stroke-linecap="round" 
                        stroke-linejoin="round" 
                        d="M5 13l4 4L19 7"
                    />
                </svg>

            </div>

            <h1 class="text-2xl sm:text-3xl font-bold text-zinc-800 mt-5">
                Order Confirmed
            </h1>

            <p class="text-sm sm:text-base text-zinc-500 mt-2 leading-relaxed max-w-sm mx-auto">
                Your payment was successful and your order is now being processed.
            </p>

        </div>

        <!-- DETAILS -->

        <div class="p-5 sm:p-7">

            <div class="border border-zinc-200 rounded-xl overflow-hidden bg-zinc-50">

                <!-- AMOUNT -->

                <div class="flex items-center justify-between gap-4 px-4 sm:px-5 py-4 border-b border-zinc-200">

                    <span class="text-sm text-zinc-500">
                        Amount Paid
                    </span>

                    <span class="text-lg font-bold text-zinc-800">
                        ₹ <%= order.totalAmount %>
                    </span>

                </div>

                <!-- PAYMENT -->

                <div class="flex items-center justify-between gap-4 px-4 sm:px-5 py-4 border-b border-zinc-200">

                    <span class="text-sm text-zinc-500">
                        Payment Method
                    </span>

                    <span class="font-semibold text-zinc-700 text-sm sm:text-base text-right">
                        <%= order.paymentMethod || 'Card' %>
                    </span>

                </div>

                <!-- STATUS -->

                <div class="flex items-center justify-between gap-4 px-4 sm:px-5 py-4 border-b border-zinc-200">

                    <span class="text-sm text-zinc-500">
                        Status
                    </span>

                    <span class="px-3 py-1 rounded-lg bg-green-100 text-green-700 text-sm font-semibold">
                        <%= order.status %>
                    </span>

                </div>

                <!-- ADDRESS -->

                <div class="px-4 sm:px-5 py-4">

                    <p class="text-sm text-zinc-500 mb-2">
                        Delivering To
                    </p>

                    <p class="text-sm sm:text-base font-medium text-zinc-700 leading-relaxed break-words">
                        <%= order.address %>
                    </p>

                </div>

            </div>

            <!-- BUTTONS -->

            <div class="mt-6 flex flex-col sm:flex-row gap-3">

                <a 
    href="/shop" 
    class="flex flex-1 items-center justify-center py-5 rounded-xl bg-black text-white text-center text-sm sm:text-base font-semibold hover:bg-zinc-800 transition"
>
    Continue Shopping
            </a>

               

            </div>

        </div>

    </div>

</div>

<%- include('./partials/footer') %>