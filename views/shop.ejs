<%- include('./partials/header') %>

<div class="w-full min-h-screen flex flex-col lg:flex-row px-4 sm:px-8 lg:px-20 py-10 gap-10 bg-zinc-100">

    <!-- SIDEBAR -->
    <div class="w-full lg:w-[22%] bg-white rounded-3xl p-6 shadow-md h-fit">

        <!-- SORT BY -->
        <div class="flex items-center gap-3">
            <h3 class="text-lg font-semibold">Sort By</h3>
            <form action="/shop" method="GET">
                <!-- preserve active filter when sorting -->
                <input type="hidden" name="filter" value="<%= filter %>">
                <select
                    class="border border-zinc-300 rounded-lg px-3 py-2 outline-none"
                    name="sortby"
                    onchange="this.form.submit()"
                >
                    <option value="popular"  <%= sortby === 'popular'  ? 'selected' : '' %>>Popular</option>
                    <option value="newest"   <%= sortby === 'newest'   ? 'selected' : '' %>>Newest</option>
                </select>
            </form>
        </div>

        <!-- COLLECTION LINKS -->
        <div class="flex flex-col mt-10 gap-3 text-zinc-700">

            <a 
                class="hover:text-black transition-all <%= filter === 'new' ? 'text-black font-semibold' : '' %>"
                href="/shop?filter=new&sortby=newest"
            >
                New Collection
            </a>

            <a 
                class="hover:text-black transition-all <%= filter === '' ? 'text-black font-semibold' : '' %>"
                href="/shop"
            >
                All Products
            </a>

            <a 
                class="hover:text-black transition-all <%= filter === 'discounted' ? 'text-black font-semibold' : '' %>"
                href="/shop?filter=discounted"
            >
                Discounted Products
            </a>

        </div>

        <!-- FILTER BY -->
        <div class="mt-12 flex flex-col gap-3 text-zinc-700">

            <h3 class="font-semibold">Filter By</h3>

            <a 
                class="hover:text-black transition-all <%= filter === 'available' ? 'text-black font-semibold' : '' %>"
                href="/shop?filter=available"
            >
                Availability
            </a>

            <a 
                class="hover:text-black transition-all <%= filter === 'discounted' ? 'text-black font-semibold' : '' %>"
                href="/shop?filter=discounted"
            >
                Discount
            </a>

        </div>

        <!-- ACTIVE FILTER BADGE -->
        <% if(filter && filter !== '') { %>
            <div class="mt-8 pt-6 border-t border-zinc-200">
                <p class="text-sm text-zinc-400 mb-2">Active filter:</p>
                <div class="flex items-center justify-between bg-zinc-100 rounded-lg px-3 py-2">
                    <span class="text-sm font-medium capitalize text-zinc-700"><%= filter %></span>
                    <a href="/shop" class="text-zinc-400 hover:text-black text-lg leading-none">×</a>
                </div>
            </div>
        <% } %>

    </div>

    <!-- PRODUCTS GRID -->
    <div class="w-full lg:w-[78%]">

        <!-- RESULTS COUNT -->
        <div class="mb-5 flex items-center justify-between">
            <p class="text-zinc-500 text-sm">
                Showing <span class="font-semibold text-black"><%= products.length %></span> products
                <% if(filter === 'new') { %> — New Collection
                <% } else if(filter === 'discounted') { %> — On Sale
                <% } else if(filter === 'available') { %> — In Stock
                <% } %>
            </p>
        </div>

        <!-- EMPTY STATE -->
        <% if(products.length === 0) { %>
            <div class="flex flex-col items-center justify-center h-64 text-zinc-400">
                <i class="ri-shopping-bag-line text-5xl mb-4"></i>
                <p class="text-lg">No products found</p>
                <a href="/shop" class="mt-4 text-black underline text-sm">View all products</a>
            </div>
        <% } else { %>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-8">

            <% products.forEach(function(product){ %>

                <div 
                    class="rounded-xl overflow-hidden shadow-md hover:scale-[1.02] transition-all duration-300"
                    style="background-color:<%= product.panelcolor %>;"
                >

                    <!-- IMAGE -->
                    <div 
                        class="w-full h-56 flex items-center justify-center p-4"
                        style="background-color:<%= product.bgcolor %>;"
                    >
                        <img 
                            class="h-[10rem] object-contain"
                            src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                            alt="<%= product.name %>"
                        >
                    </div>

                    <!-- DETAILS -->
                    <div 
                        class="flex justify-between items-center px-5 py-5"
                        style="color:<%= product.textcolor %>;"
                    >
                        <div>
                            <h3 class="text-lg font-semibold"><%= product.name %></h3>

                            <% if(product.discount > 0) { %>
                                <h4 class="mt-1 text-sm line-through opacity-50">₹ <%= product.price %></h4>
                                <h4 class="text-base font-semibold">₹ <%= product.price - product.discount %></h4>
                                <span class="text-xs bg-green-500 text-white px-2 py-0.5 rounded-full">
                                    <%= Math.round((product.discount / product.price) * 100) %>% OFF
                                </span>
                            <% } else { %>
                                <h4 class="mt-1 text-base">₹ <%= product.price %></h4>
                            <% } %>
                        </div>

                        <a 
                            class="w-10 h-10 flex items-center justify-center rounded-full bg-white text-black shadow-md hover:scale-110 transition-all"
                            href="/addtocart/<%= product._id %>"
                        >
                            <i class="ri-add-line text-lg"></i>
                        </a>

                    </div>

                </div>

            <% }) %>

        </div>

        <% } %>

    </div>

</div>

<%- include('./partials/footer') %>