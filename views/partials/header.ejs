<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BagSphere</title>

    <link 
        href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" 
        rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-zinc-100">

<!-- NAVBAR -->

<nav class="w-full bg-white border-b border-zinc-200 sticky top-0 z-50">

    <div class="max-w-7xl mx-auto h-28 px-6 sm:px-8 lg:px-14 flex items-center justify-between">

        <!-- LOGO -->

        <a 
            href="/" 
            class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900"
        >
            BagSphere
        </a>

        <% var loggedin = typeof loggedin !== 'undefined' ? loggedin : true; %>

        <% if(loggedin){ %>

        <!-- LINKS -->

        <div class="flex items-center gap-4 sm:gap-6 text-sm sm:text-base font-medium text-zinc-700">

            <a 
                href="/shop"
                class="hover:text-black transition"
            >
                Shop
            </a>

            <a 
                href="/cart"
                class="hover:text-black transition"
            >
                Cart
            </a>

            <a 
                href="/logout"
                class="text-red-500 hover:text-red-600 transition"
            >
                Logout
            </a>

        </div>

        <% } %>

    </div>

</nav>