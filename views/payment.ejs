<%- include('./partials/header') %>

<style>
    .payment-tab { transition: all 0.2s; }
    .payment-tab.active { background: #000; color: #fff; }
    .payment-section { display: none; }
    .payment-section.active { display: block; }
    .card-input { letter-spacing: 0.1em; }
    input:focus { outline: none; border-color: #000; }
    .upi-app-btn:hover { border-color: #000; background: #f4f4f4; }
    .pay-btn { position: relative; overflow: hidden; }
    .pay-btn::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,0.15);
        transform: translateX(-100%);
        transition: transform 0.4s;
    }
    .pay-btn:hover::after { transform: translateX(0); }
</style>

<div class="w-full min-h-screen bg-zinc-100 px-4 sm:px-8 lg:px-16 py-10">

    <a href="/checkout" class="inline-flex items-center gap-2 text-zinc-500 hover:text-black transition mb-8 text-sm font-medium">
        <i class="ri-arrow-left-line"></i> Back to Checkout
    </a>

    <div class="flex flex-col lg:flex-row gap-8 max-w-5xl mx-auto">

        <!-- LEFT: PAYMENT FORM -->
        <div class="w-full lg:w-[60%]">

            <div class="bg-white rounded-2xl p-8 shadow-lg">

                <h2 class="text-2xl font-bold mb-1">Payment</h2>
                <p class="text-zinc-400 text-sm mb-6">All transactions are secure and encrypted</p>

                <!-- TABS -->
                <div class="flex gap-2 mb-7 p-1 bg-zinc-100 rounded-xl">
                    <button onclick="switchTab('card')" id="tab-card"
                        class="payment-tab active flex-1 py-2.5 rounded-lg text-sm font-semibold flex items-center justify-center gap-2">
                        <i class="ri-bank-card-line"></i> Card
                    </button>
                    <button onclick="switchTab('upi')" id="tab-upi"
                        class="payment-tab flex-1 py-2.5 rounded-lg text-sm font-semibold flex items-center justify-center gap-2">
                        <i class="ri-qr-code-line"></i> UPI
                    </button>
                    <button onclick="switchTab('netbanking')" id="tab-netbanking"
                        class="payment-tab flex-1 py-2.5 rounded-lg text-sm font-semibold flex items-center justify-center gap-2">
                        <i class="ri-building-line"></i> Net Banking
                    </button>
                    <button onclick="switchTab('cod')" id="tab-cod"
                        class="payment-tab flex-1 py-2.5 rounded-lg text-sm font-semibold flex items-center justify-center gap-2">
                        <i class="ri-money-rupee-circle-line"></i> COD
                    </button>
                </div>

                <form id="paymentForm" action="/placeorder" method="POST">
                    <input type="hidden" name="address" value="<%= address %>">
                    <input type="hidden" name="paymentMethod" id="paymentMethodInput" value="Card">

                    <!-- CARD SECTION -->
                    <div id="section-card" class="payment-section active">
                        <div class="mb-5">
                            <label class="block text-xs font-semibold text-zinc-500 uppercase tracking-widest mb-2">Card Number</label>
                            <div class="relative">
                                <input
                                    type="text"
                                    maxlength="19"
                                    placeholder="1234 5678 9012 3456"
                                    oninput="formatCard(this)"
                                    class="card-input w-full border border-zinc-200 rounded-xl px-4 py-3.5 text-lg pr-12 transition"
                                />
                                <i class="ri-bank-card-2-line absolute right-4 top-1/2 -translate-y-1/2 text-zinc-400 text-xl"></i>
                            </div>
                        </div>

                        <div class="mb-5">
                            <label class="block text-xs font-semibold text-zinc-500 uppercase tracking-widest mb-2">Cardholder Name</label>
                            <input
                                type="text"
                                placeholder="Name on card"
                                class="w-full border border-zinc-200 rounded-xl px-4 py-3.5 transition uppercase"
                            />
                        </div>

                        <div class="flex gap-4 mb-7">
                            <div class="flex-1">
                                <label class="block text-xs font-semibold text-zinc-500 uppercase tracking-widest mb-2">Expiry</label>
                                <input
                                    type="text"
                                    maxlength="5"
                                    placeholder="MM/YY"
                                    oninput="formatExpiry(this)"
                                    class="w-full border border-zinc-200 rounded-xl px-4 py-3.5 transition"
                                />
                            </div>
                            <div class="flex-1">
                                <label class="block text-xs font-semibold text-zinc-500 uppercase tracking-widest mb-2">CVV</label>
                                <input
                                    type="password"
                                    maxlength="3"
                                    placeholder="•••"
                                    class="w-full border border-zinc-200 rounded-xl px-4 py-3.5 transition"
                                />
                            </div>
                        </div>

                        <div class="flex items-center gap-3 mb-6 p-3 bg-zinc-50 rounded-xl border border-zinc-200">
                            <i class="ri-shield-check-line text-green-600 text-xl"></i>
                            <p class="text-xs text-zinc-500">Your card details are encrypted with 256-bit SSL. We never store your card information.</p>
                        </div>

                        <!-- accepted cards -->
                        <div class="flex items-center gap-3 mb-6">
                            <span class="text-xs text-zinc-400">Accepted:</span>
                            <div class="flex gap-2">
                                <div class="px-3 py-1 border border-zinc-200 rounded-lg text-xs font-bold text-blue-700">VISA</div>
                                <div class="px-3 py-1 border border-zinc-200 rounded-lg text-xs font-bold text-red-600">MC</div>
                                <div class="px-3 py-1 border border-zinc-200 rounded-lg text-xs font-bold text-blue-500">RUPAY</div>
                                <div class="px-3 py-1 border border-zinc-200 rounded-lg text-xs font-bold text-orange-500">AMEX</div>
                            </div>
                        </div>
                    </div>

                    <!-- UPI SECTION -->
                    <div id="section-upi" class="payment-section">

                        <p class="text-xs font-semibold text-zinc-500 uppercase tracking-widest mb-4">Pay with UPI App</p>

                        <div class="grid grid-cols-2 gap-3 mb-6">
                            <label class="upi-app-btn flex items-center gap-3 border-2 border-zinc-200 rounded-xl p-4 cursor-pointer transition">
                                <input type="radio" name="upiApp" value="gpay" class="hidden">
                                <div class="w-9 h-9 rounded-lg bg-white flex items-center justify-center shadow-sm border border-zinc-100">
                                    <span class="text-sm font-black text-blue-600">G</span>
                                </div>
                                <span class="font-semibold text-sm">Google Pay</span>
                            </label>

                            <label class="upi-app-btn flex items-center gap-3 border-2 border-zinc-200 rounded-xl p-4 cursor-pointer transition">
                                <input type="radio" name="upiApp" value="phonepe" class="hidden">
                                <div class="w-9 h-9 rounded-lg bg-purple-600 flex items-center justify-center shadow-sm">
                                    <span class="text-white text-xs font-black">Pe</span>
                                </div>
                                <span class="font-semibold text-sm">PhonePe</span>
                            </label>

                            <label class="upi-app-btn flex items-center gap-3 border-2 border-zinc-200 rounded-xl p-4 cursor-pointer transition">
                                <input type="radio" name="upiApp" value="paytm" class="hidden">
                                <div class="w-9 h-9 rounded-lg bg-blue-500 flex items-center justify-center shadow-sm">
                                    <span class="text-white text-xs font-black">Pa</span>
                                </div>
                                <span class="font-semibold text-sm">Paytm</span>
                            </label>

                            <label class="upi-app-btn flex items-center gap-3 border-2 border-zinc-200 rounded-xl p-4 cursor-pointer transition">
                                <input type="radio" name="upiApp" value="other" class="hidden">
                                <div class="w-9 h-9 rounded-lg bg-zinc-800 flex items-center justify-center shadow-sm">
                                    <i class="ri-qr-code-line text-white text-sm"></i>
                                </div>
                                <span class="font-semibold text-sm">Other UPI</span>
                            </label>
                        </div>

                        <div class="relative mb-7">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-400 text-sm font-medium">Or enter UPI ID</span>
                            <input
                                type="text"
                                placeholder="     yourname@upi"
                                class="w-full border border-zinc-200 rounded-xl px-4 py-3.5 transition pl-28"
                            />
                        </div>
                    </div>

                    <!-- NET BANKING SECTION -->
                    <div id="section-netbanking" class="payment-section">
                        <p class="text-xs font-semibold text-zinc-500 uppercase tracking-widest mb-4">Select Your Bank</p>

                        <div class="grid grid-cols-2 gap-3 mb-6">
                            <% ['SBI', 'HDFC', 'ICICI', 'Axis', 'Kotak', 'Yes Bank', 'Punjab National', 'Bank of Baroda'].forEach(bank => { %>
                                <label class="upi-app-btn flex items-center gap-3 border-2 border-zinc-200 rounded-xl px-4 py-3 cursor-pointer transition">
                                    <input type="radio" name="bank" value="<%= bank %>" class="accent-black">
                                    <span class="font-medium text-sm"><%= bank %></span>
                                </label>
                            <% }) %>
                        </div>

                        <div class="mb-7">
                            <label class="block text-xs font-semibold text-zinc-500 uppercase tracking-widest mb-2">Or search bank</label>
                            <input type="text" placeholder="Search your bank..." class="w-full border border-zinc-200 rounded-xl px-4 py-3.5 transition"/>
                        </div>
                    </div>

                    <!-- COD SECTION -->
                    <div id="section-cod" class="payment-section">
                        <div class="flex flex-col items-center text-center py-8">
                            <div class="w-20 h-20 rounded-full bg-zinc-100 flex items-center justify-center mb-5">
                                <i class="ri-money-rupee-circle-line text-4xl text-zinc-700"></i>
                            </div>
                            <h3 class="text-xl font-bold mb-2">Cash on Delivery</h3>
                            <p class="text-zinc-400 text-sm max-w-xs">Pay with cash when your order arrives at your doorstep. No online transaction required.</p>
                            <div class="mt-6 w-full bg-amber-50 border border-amber-200 rounded-xl p-4 text-left">
                                <div class="flex gap-3 items-start">
                                    <i class="ri-information-line text-amber-600 mt-0.5"></i>
                                    <p class="text-xs text-amber-700">Please keep exact change of <strong>₹ <%= finalAmount %></strong> ready at the time of delivery.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <button 
    type="button" 
    id="payBtn"
    onclick="handlePay(event)" 
    class="pay-btn w-full py-4 rounded-xl bg-black text-white text-lg font-semibold hover:bg-zinc-800 transition flex items-center justify-center gap-3"
>
    <i class="ri-lock-line"></i>
    Pay ₹ <%= finalAmount %> Securely
</button>
                </form>

            </div>
        </div>

        <!-- RIGHT: ORDER SUMMARY -->
        <div class="w-full lg:w-[40%] lg:sticky lg:top-6 self-start space-y-4">

            <div class="bg-white rounded-2xl p-6 shadow-lg">
                <h3 class="font-bold text-lg mb-4 border-b border-zinc-100 pb-3">Order Summary</h3>

                <div class="space-y-3 mb-4">
                    <% orderItems.forEach(function(product){ %>
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 rounded-lg overflow-hidden flex-shrink-0" style="background-color:<%= product.panelcolor %>;">
                                <img class="w-full h-full object-contain" src="data:image/png;base64,<%= product.image.toString('base64') %>" alt="<%= product.name %>">
                            </div>
                            <div class="flex-1">
                                <p class="text-sm font-semibold leading-tight"><%= product.name %></p>
                            </div>
                            <p class="text-sm font-bold">₹ <%= product.discount > 0 ? product.price - product.discount : product.price %></p>
                        </div>
                    <% }) %>
                </div>

                <div class="border-t border-zinc-100 pt-4 space-y-2 text-sm">
                    <div class="flex justify-between text-zinc-500">
                        <span>Subtotal</span><span>₹ <%= subtotal %></span>
                    </div>
                    <div class="flex justify-between text-zinc-500">
                        <span>Platform Fee</span><span>₹ 20</span>
                    </div>
                    <div class="flex justify-between text-zinc-500">
                        <span>Shipping</span><span class="text-green-600">FREE</span>
                    </div>
                    <div class="flex justify-between font-bold text-base pt-2 border-t border-zinc-200">
                        <span>Total</span>
                        <span class="text-green-600">₹ <%= finalAmount %></span>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-5 shadow-lg">
                <h3 class="font-bold text-sm mb-3 text-zinc-500 uppercase tracking-widest">Delivering To</h3>
                <div class="flex gap-3 items-start">
                    <i class="ri-map-pin-2-line text-zinc-400 mt-0.5"></i>
                    <p class="text-sm text-zinc-700 leading-relaxed"><%= address %></p>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
function switchTab(tab) {
    document.querySelectorAll('.payment-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.payment-section').forEach(s => s.classList.remove('active'));
    document.getElementById('tab-' + tab).classList.add('active');
    document.getElementById('section-' + tab).classList.add('active');
    const labels = { card: 'Card', upi: 'UPI', netbanking: 'Net Banking', cod: 'Cash on Delivery' };
    document.getElementById('paymentMethodInput').value = labels[tab];
}

function formatCard(input) {
    let v = input.value.replace(/\D/g, '').substring(0, 16);
    input.value = v.replace(/(.{4})/g, '$1 ').trim();
}

function formatExpiry(input) {
    let v = input.value.replace(/\D/g, '').substring(0, 4);
    if (v.length >= 2) v = v.substring(0,2) + '/' + v.substring(2);
    input.value = v;
}

function handlePay(e) {
    e.preventDefault();

    const btn = document.getElementById('payBtn');
    btn.innerHTML = '<i class="ri-loader-4-line animate-spin"></i> Processing...';
    btn.disabled = true;

    // Show success overlay after 2 seconds
    setTimeout(() => {
        document.getElementById('successOverlay').classList.remove('hidden');
        document.getElementById('successOverlay').classList.add('flex');
    }, 2000);

    // Submit form after 4 seconds (2s processing + 2s showing success)
    setTimeout(() => {
        document.getElementById('paymentForm').submit();
    }, 4000);
}
</script>
<!-- PAYMENT SUCCESS OVERLAY -->
<div id="successOverlay" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 items-center justify-center">
    <div class="bg-white rounded-3xl p-10 max-w-sm w-full mx-4 text-center shadow-2xl">

        <!-- Animated checkmark -->
        <div class="w-24 h-24 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-6 animate-bounce">
            <svg class="w-12 h-12 text-green-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
        </div>

        <h2 class="text-2xl font-bold text-zinc-800 mb-2">Payment Successful!</h2>
        <p class="text-zinc-400 text-sm mb-6">Your order has been placed. Redirecting you now...</p>

        <!-- Animated progress bar -->
        <div class="w-full bg-zinc-100 rounded-full h-1.5 overflow-hidden">
            <div class="h-full bg-green-500 rounded-full animate-progress"></div>
        </div>

        <p class="text-xs text-zinc-400 mt-3">Redirecting in 2 seconds...</p>
    </div>
</div>

<style>
    @keyframes progress {
        from { width: 0%; }
        to { width: 100%; }
    }
    .animate-progress {
        animation: progress 2s linear forwards;
    }
</style>
<%- include('./partials/footer') %>
