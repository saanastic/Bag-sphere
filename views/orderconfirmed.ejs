<%- include('./partials/header') %>

<style>
    @keyframes scaleIn {
        from { transform: scale(0); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }
    @keyframes checkDraw {
        from { stroke-dashoffset: 100; }
        to { stroke-dashoffset: 0; }
    }
    @keyframes slideUp {
        from { transform: translateY(30px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @keyframes ripple {
        0% { transform: scale(1); opacity: 0.4; }
        100% { transform: scale(2.5); opacity: 0; }
    }
    @keyframes confettiFall {
        0% { transform: translateY(-20px) rotate(0deg); opacity: 1; }
        100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
    }

    .circle-wrap {
        animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) 0.2s both;
    }
    .check-path {
        stroke-dasharray: 100;
        stroke-dashoffset: 100;
        animation: checkDraw 0.6s ease 0.7s forwards;
    }
    .ripple-ring {
        position: absolute;
        inset: 0;
        border-radius: 9999px;
        border: 2px solid #22c55e;
        animation: ripple 1.5s ease-out 0.9s infinite;
    }
    .slide-up-1 { animation: slideUp 0.5s ease 0.9s both; }
    .slide-up-2 { animation: slideUp 0.5s ease 1.1s both; }
    .slide-up-3 { animation: slideUp 0.5s ease 1.3s both; }
    .slide-up-4 { animation: slideUp 0.5s ease 1.5s both; }
    .slide-up-5 { animation: slideUp 0.5s ease 1.7s both; }

    .confetti-piece {
        position: fixed;
        width: 10px;
        height: 10px;
        top: -10px;
        animation: confettiFall linear forwards;
    }

    .countdown-bar {
        animation: shrink linear forwards;
    }
    @keyframes shrink {
        from { width: 100%; }
        to { width: 0%; }
    }
</style>

<!-- Confetti container -->
<div id="confetti" class="pointer-events-none z-50"></div>

<div class="w-full min-h-screen bg-zinc-100 flex items-center justify-center px-4 py-16">

    <div class="max-w-lg w-full">

        <!-- SUCCESS CARD -->
        <div class="bg-white rounded-3xl shadow-xl p-10 text-center slide-up-1">

            <!-- Animated checkmark -->
            <div class="relative w-28 h-28 mx-auto mb-8">
                <div class="ripple-ring"></div>
                <div class="circle-wrap w-28 h-28 rounded-full bg-green-50 border-4 border-green-500 flex items-center justify-center relative">
                    <svg viewBox="0 0 52 52" class="w-14 h-14">
                        <path
                            class="check-path"
                            fill="none"
                            stroke="#22c55e"
                            stroke-width="4"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M14 27l8 8 16-16"
                        />
                    </svg>
                </div>
            </div>

            <div class="slide-up-2">
                <h1 class="text-3xl font-black text-zinc-900 mb-2">Order Confirmed!</h1>
                <p class="text-zinc-400 text-sm">Thank you for shopping with <span class="font-semibold text-zinc-600">BagSphere</span></p>
            </div>

            <!-- ORDER DETAILS -->
            <div class="slide-up-3 mt-7 bg-zinc-50 rounded-2xl p-5 text-left border border-zinc-100 space-y-3">

                <div class="flex justify-between items-center py-2 border-b border-zinc-200">
                    <span class="text-zinc-400 text-sm flex items-center gap-2">
                        <i class="ri-shopping-bag-line"></i> Items
                    </span>
                    <span class="font-semibold text-sm"><%= order.products.length %> item<%= order.products.length > 1 ? 's' : '' %></span>
                </div>

                <div class="flex justify-between items-center py-2 border-b border-zinc-200">
                    <span class="text-zinc-400 text-sm flex items-center gap-2">
                        <i class="ri-money-rupee-circle-line"></i> Amount Paid
                    </span>
                    <span class="font-bold text-green-600">₹ <%= order.totalAmount %></span>
                </div>

                <div class="flex justify-between items-center py-2 border-b border-zinc-200">
                    <span class="text-zinc-400 text-sm flex items-center gap-2">
                        <i class="ri-bank-card-line"></i> Payment
                    </span>
                    <span class="font-semibold text-sm"><%= order.paymentMethod %></span>
                </div>

                <div class="flex justify-between items-start py-2 border-b border-zinc-200">
                    <span class="text-zinc-400 text-sm flex items-center gap-2">
                        <i class="ri-map-pin-2-line"></i> Deliver To
                    </span>
                    <span class="font-semibold text-sm text-right max-w-[55%] leading-snug"><%= order.address %></span>
                </div>

                <div class="flex justify-between items-center py-2">
                    <span class="text-zinc-400 text-sm flex items-center gap-2">
                        <i class="ri-truck-line"></i> Status
                    </span>
                    <span class="bg-green-100 text-green-700 text-xs font-bold px-3 py-1 rounded-full"><%= order.status %></span>
                </div>

            </div>

            <!-- ESTIMATED DELIVERY -->
            <div class="slide-up-4 mt-5 flex items-center gap-4 bg-blue-50 border border-blue-100 rounded-xl p-4">
                <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center flex-shrink-0">
                    <i class="ri-truck-line text-blue-600"></i>
                </div>
                <div class="text-left">
                    <p class="text-xs text-blue-400 font-medium">Estimated Delivery</p>
                    <p class="text-sm font-bold text-blue-700">
                        <%
                            let delivery = new Date();
                            delivery.setDate(delivery.getDate() + 5);
                            let options = { weekday: 'long', month: 'long', day: 'numeric' };
                        %>
                        <%= delivery.toLocaleDateString('en-IN', options) %>
                    </p>
                </div>
            </div>

            <!-- CTA BUTTON with countdown -->
            <div class="slide-up-5 mt-8">
                <p class="text-xs text-zinc-400 mb-3">Redirecting to shop in <span id="countdownNum">5</span>s...</p>
                <div class="w-full h-1 bg-zinc-100 rounded-full mb-4 overflow-hidden">
                    <div id="countdownBar" class="h-full bg-black rounded-full countdown-bar" style="animation-duration: 5s;"></div>
                </div>
                <a href="/shop" class="block w-full py-4 rounded-xl bg-black text-white text-lg font-semibold hover:bg-zinc-800 transition text-center">
                    Continue Shopping <i class="ri-arrow-right-line"></i>
                </a>
            </div>

        </div>

    </div>
</div>

<script>
// Confetti
(function() {
    const colors = ['#000000', '#22c55e', '#3b82f6', '#f59e0b', '#ef4444', '#8b5cf6'];
    const container = document.getElementById('confetti');
    for (let i = 0; i < 60; i++) {
        const piece = document.createElement('div');
        piece.className = 'confetti-piece';
        piece.style.cssText = `
            left: ${Math.random() * 100}vw;
            background: ${colors[Math.floor(Math.random() * colors.length)]};
            width: ${Math.random() * 8 + 6}px;
            height: ${Math.random() * 8 + 6}px;
            border-radius: ${Math.random() > 0.5 ? '50%' : '2px'};
            animation-duration: ${Math.random() * 3 + 2}s;
            animation-delay: ${Math.random() * 1.5}s;
        `;
        container.appendChild(piece);
    }
    setTimeout(() => container.remove(), 6000);
})();

// Countdown
let count = 5;
const num = document.getElementById('countdownNum');
const timer = setInterval(() => {
    count--;
    if (num) num.textContent = count;
    if (count <= 0) {
        clearInterval(timer);
        window.location.href = '/shop';
    }
}, 1000);
</script>

<%- include('./partials/footer') %>
