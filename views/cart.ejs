<%- include('./partials/header') %>

<div class="w-full min-h-screen flex flex-col lg:flex-row gap-8 px-4 sm:px-8 lg:px-16 py-10 bg-zinc-100">
    <% if(user.cart.length === 0){ %>

     <!-- EMPTY CART -->

<div class="w-full min-h-[70vh] flex items-center justify-center px-4 bg-zinc-100">

    <div class="w-full max-w-md bg-white border border-zinc-200 rounded-2xl shadow-sm p-8 flex flex-col items-center text-center">

        <!-- CART ICON -->

        <div class="w-16 h-16 rounded-full bg-zinc-100 flex items-center justify-center mb-5">

            <svg 
                class="w-8 h-8 text-zinc-500" 
                fill="none" 
                stroke="currentColor" 
                stroke-width="1.8" 
                viewBox="0 0 24 24"
            >
                <path 
                    stroke-linecap="round" 
                    stroke-linejoin="round" 
                    d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c.51 0 .955-.343 1.087-.835l1.45-5.437A1.125 1.125 0 0019.97 8.25H7.107M7.5 14.25L5.106 5.272"
                />
            </svg>

        </div>

        <!-- TEXT -->

        <h2 class="text-2xl font-semibold text-zinc-800">
            Your cart is empty
        </h2>

        <p class="text-sm text-zinc-500 mt-2 leading-relaxed">
            Looks like you haven’t added any products to your cart yet.
        </p>

        <!-- BUTTON -->

        <a 
            href="/shop" 
            class="mt-6 px-6 py-3 bg-black text-white text-sm font-medium rounded-lg hover:bg-zinc-800 transition-all duration-200"
        >
            Continue Shopping
        </a>

    </div>

</div>

<% } else { %>

    <!-- LEFT : CART ITEMS -->

    <div class="w-full lg:w-[65%] grid grid-cols-1 sm:grid-cols-2 gap-5">

        <% user.cart.forEach(function(product){ %>

            <div 
                class="rounded-2xl p-4 shadow-md hover:scale-[1.01] transition duration-300"
                style="background-color: <%= product.bgcolor %>; color: <%= product.textcolor %>;"
            >

                <div 
                    class="w-full h-56 rounded-xl flex items-center justify-center overflow-hidden"
                    style="background-color: <%= product.panelcolor %>;"
                >

                    <img 
                        class="w-full h-full object-contain"
                        src="data:image/png;base64,<%= product.image.toString('base64') %>"
                        alt="<%= product.name %>"
                    >

                </div>

                <div class="flex justify-between items-center mt-4">

                    <div>

                        <h2 class="text-xl font-semibold">
                            <%= product.name %>
                        </h2>

                        <h3 class="text-lg mt-1 font-medium">
                            ₹ <%= product.price %>
                        </h3>

                    </div>

                    <!-- Replace the +/- button section -->
<div class="flex items-center gap-2">
    <a 
        href="/removefromcart/<%= product._id %>"
        class="w-8 h-8 rounded-lg bg-white text-black font-bold shadow flex items-center justify-center"
    >−</a>

    <span class="text-lg font-semibold">
        1
    </span>

    <a 
        href="/addtocart/<%= product._id %>"
        class="w-8 h-8 rounded-lg bg-white text-black font-bold shadow flex items-center justify-center"
    >+</a>
</div>

                </div>

            </div>

        <% }) %>

    </div>

   <!-- RIGHT : BILL SECTION -->

<div class="w-full lg:w-[35%] lg:sticky lg:top-6 self-start">

    <%
        let total = 0;

        user.cart.forEach(function(product){
            total += Number(product.price);
        });

        let platformFee = 20;
        let finalAmount = total + platformFee;
    %>

    <div class="bg-white rounded-2xl p-6 shadow-lg">

        <h2 class="text-2xl font-bold border-b border-zinc-300 pb-4">
            Price Breakdown
        </h2>

        <div class="mt-6 space-y-4 text-lg">

            <div class="flex justify-between">
                <h4>Total MRP</h4>
                <h4>₹ <%= total %></h4>
            </div>

            <div class="flex justify-between">
                <h4>Discount on MRP</h4>
                <h4 class="text-green-600">₹ 0</h4>
            </div>

            <div class="flex justify-between">
                <h4>Platform Fee</h4>
                <h4>₹ <%= platformFee %></h4>
            </div>

            <div class="flex justify-between">
                <h4>Shipping Fee</h4>
                <h4 class="text-green-600">FREE</h4>
            </div>

        </div>

        <div class="w-full h-[1px] bg-zinc-300 my-6"></div>

        <div class="flex justify-between items-center">

            <h2 class="text-2xl font-bold">
                Total Amount
            </h2>

            <h2 class="text-3xl font-bold text-green-600">
                ₹ <%= finalAmount %>
            </h2>

        </div>

        <a href="/checkout" class="block w-full py-4 rounded-xl bg-black text-white text-lg font-semibold mt-6 hover:bg-zinc-800 transition text-center">
    Proceed To Checkout
</a>

    </div>

</div>
<% } %>

</div>

<%- include('./partials/footer') %>